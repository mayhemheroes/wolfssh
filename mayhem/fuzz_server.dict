# SSH wire-format tokens to help the fuzzer reach the wolfSSH parsers early.
"SSH-2.0-"
"SSH-1.99-"
"\x00\x00\x00\x00"
"ssh-rsa"
"ssh-ed25519"
"ecdsa-sha2-nistp256"
"diffie-hellman-group14-sha256"
"diffie-hellman-group14-sha1"
"curve25519-sha256"
"ecdh-sha2-nistp256"
"aes128-ctr"
"aes256-ctr"
"aes128-gcm@openssh.com"
"hmac-sha2-256"
"hmac-sha1"
"none"
"password"
"publickey"
"ssh-connection"
"ssh-userauth"
"session"
